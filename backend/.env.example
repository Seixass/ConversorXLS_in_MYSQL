APP_NAME="Hub Ronda no Bairro"
# Em produção: local, e sempre com APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origem do frontend do Hub, liberada no CORS (config/cors.php). No servidor real, trocar pela URL pública.
FRONTEND_URL=http://localhost:5174

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Rotaciona diariamente e descarta logs com mais de 14 dias — evita crescimento sem limite.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Local/mock: SQLite (arquivo único). No servidor real, trocar para mysql + host/porta/schema "hub".
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hub
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# API stateless — nada é enfileirado, "sync" evita depender de um worker rodando em background.
QUEUE_CONNECTION=sync

# Cache em arquivo em vez de banco: o rate limit do login não fica escrevendo no SQLite.
CACHE_STORE=file
# CACHE_PREFIX=

# JWT do Hub — mesmo padrão do RondaSocial (firebase/php-jwt, HS256). Gere uma chave própria em produção.
JWT_SECRET=
JWT_TTL=28800

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
